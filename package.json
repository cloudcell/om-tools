{
  "name": "om-tools",
  "displayName": "OM Core",
  "description": "Multidimensional modeling engine GUI for OM Core — connects to the om-core runtime.",
  "version": "0.1.0",
  "publisher": "om-core",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudcell/om-tools.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode OM Tools does not start the om-core runtime and ignores workspace settings for the runtime path and endpoint. You can still connect to a runtime that is already running.",
      "restrictedConfigurations": [
        "omCore.omCorePath",
        "omCore.runtimeEndpoint"
      ]
    }
  },
  "categories": [
    "Other",
    "Data Science",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "omCore.openGui",
        "title": "OM Core: Open GUI",
        "category": "OM Core",
        "icon": "$(play)"
      },
      {
        "command": "omCore.closeGui",
        "title": "OM Core: Close GUI",
        "category": "OM Core",
        "icon": "$(close)"
      },
      {
        "command": "omCore.startRuntime",
        "title": "OM Core: Start Runtime",
        "category": "OM Core",
        "icon": "$(debug-start)"
      },
      {
        "command": "omCore.stopRuntime",
        "title": "OM Core: Stop Runtime",
        "category": "OM Core",
        "icon": "$(debug-stop)"
      },
      {
        "command": "omCore.reconnect",
        "title": "OM Core: Reconnect to Runtime",
        "category": "OM Core",
        "icon": "$(plug)"
      },
      {
        "command": "omCore.refreshStatus",
        "title": "OM Core: Refresh Status",
        "category": "OM Core",
        "icon": "$(refresh)"
      },
      {
        "command": "omCore.choosePath",
        "title": "OM Core: Choose om-core Folder…",
        "category": "OM Core",
        "icon": "$(edit)"
      },
      {
        "command": "omCore.openSettings",
        "title": "OM Core: Open Settings",
        "category": "OM Core",
        "icon": "$(gear)"
      },
      {
        "command": "omCore.revealPath",
        "title": "OM Core: Reveal om-core Folder in File Explorer",
        "category": "OM Core",
        "icon": "$(folder-opened)"
      },
      {
        "command": "omCore.manageTrust",
        "title": "OM Core: Manage Workspace Trust",
        "category": "OM Core",
        "icon": "$(shield)"
      },
      {
        "command": "omCore.uvInstallHelp",
        "title": "OM Core: How to Install uv",
        "category": "OM Core",
        "icon": "$(link-external)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omCore",
          "title": "OM Core",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "omCore": [
        {
          "id": "omCore.launchPad",
          "name": "OM Core",
          "icon": "media/icon.svg",
          "initialSize": 1
        },
        {
          "id": "omCore.actions",
          "name": "Actions",
          "initialSize": 1000
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "omCore.launchPad",
        "contents": "Checking the engine…"
      },
      {
        "view": "omCore.actions",
        "contents": "[Start Runtime](command:omCore.startRuntime \"Start the engine\")\nStarts the engine only. The GUI is separate.",
        "when": "omCore.runtimeButton == start"
      },
      {
        "view": "omCore.actions",
        "contents": "[Stop Runtime](command:omCore.stopRuntime \"Stop the engine\")\nStops the engine. A model that was not saved is lost.",
        "when": "omCore.runtimeButton == stop"
      },
      {
        "view": "omCore.actions",
        "contents": "Starting the runtime…",
        "when": "omCore.runtimeButton == starting"
      },
      {
        "view": "omCore.actions",
        "contents": "The runtime was started outside OM Tools. Stop it where it was started.",
        "when": "omCore.runtimeButton == external"
      },
      {
        "view": "omCore.actions",
        "contents": "[Open GUI](command:omCore.openGui \"Open the grid in an editor tab\")\nOpens the grid. It connects if the runtime is running.",
        "when": "omCore.guiButton == open"
      },
      {
        "view": "omCore.actions",
        "contents": "[Close GUI](command:omCore.closeGui \"Close the grid tab\")\nCloses the grid tab. The runtime keeps running.",
        "when": "omCore.guiButton == close"
      },
      {
        "view": "omCore.actions",
        "contents": "Opening the GUI…",
        "when": "omCore.guiButton == opening"
      },
      {
        "view": "omCore.actions",
        "contents": "[Settings](command:omCore.openSettings \"Open the OM Core settings\")"
      }
    ],
    "configuration": {
      "title": "OM Core",
      "properties": {
        "omCore.runtimeEndpoint": {
          "type": "string",
          "default": "",
          "description": "Transport endpoint for the om-core runtime. Empty = auto-detect: uses OPENM_TRANSPORT_SOCKET or OPENM_TRANSPORT_HOST/PORT env vars when set, probes /tmp/openm-<user>.sock then tcp://127.0.0.1:17391 for a live runtime, and falls back to the platform default (unix socket on Linux/macOS, TCP on Windows), where Start Runtime starts a runtime. Examples: 'tcp://127.0.0.1:17391', 'unix:///tmp/openm-<user>.sock'."
        },
        "omCore.omCorePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "[Choose folder…](command:omCore.choosePath \"Pick the om-core folder; the answer is saved here\")\n\nAbsolute path to the om-core project root (used by Start Runtime to launch the runtime). Empty = auto-detect: `OM_CORE_PATH` env var, a workspace folder that is an om-core checkout (contains `main.py` and `lib_runtime/`), or a one-time folder picker whose answer is saved here."
        },
        "omCore.showSystemElements": {
          "type": "boolean",
          "default": false,
          "description": "Show system elements (names beginning with '%') in the Model Browser, tabs, and selectors."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "omCore.refreshStatus",
          "when": "view == omCore.launchPad",
          "group": "navigation@1"
        },
        {
          "command": "omCore.reconnect",
          "when": "view == omCore.launchPad",
          "group": "1_runtime@1"
        }
      ],
      "view/item/context": [
        { "command": "omCore.startRuntime", "when": "view == omCore.launchPad && viewItem == runtime-stopped", "group": "inline@1" },
        { "command": "omCore.stopRuntime", "when": "view == omCore.launchPad && viewItem == runtime-ours", "group": "inline@1" },
        { "command": "omCore.manageTrust", "when": "view == omCore.launchPad && viewItem == runtime-restricted", "group": "inline@1" },
        { "command": "omCore.openSettings", "when": "view == omCore.launchPad && viewItem == runtime-endpoint-error", "group": "inline@1" },
        { "command": "omCore.openGui", "when": "view == omCore.launchPad && viewItem == gui-closed", "group": "inline@1" },
        { "command": "omCore.reconnect", "when": "view == omCore.launchPad && viewItem == gui-disconnected", "group": "inline@1" },
        { "command": "omCore.uvInstallHelp", "when": "view == omCore.launchPad && viewItem == uv-missing", "group": "inline@1" },

        { "command": "omCore.startRuntime", "when": "view == omCore.launchPad && viewItem == runtime-stopped", "group": "1_actions@1" },
        { "command": "omCore.stopRuntime", "when": "view == omCore.launchPad && viewItem == runtime-ours", "group": "1_actions@1" },
        { "command": "omCore.manageTrust", "when": "view == omCore.launchPad && viewItem == runtime-restricted", "group": "1_actions@1" },
        { "command": "omCore.openSettings", "when": "view == omCore.launchPad && viewItem == runtime-endpoint-error", "group": "1_actions@1" },
        { "command": "omCore.openGui", "when": "view == omCore.launchPad && viewItem =~ /^gui-/", "group": "1_actions@1" },
        { "command": "omCore.reconnect", "when": "view == omCore.launchPad && viewItem == gui-disconnected", "group": "1_actions@2" },
        { "command": "omCore.choosePath", "when": "view == omCore.launchPad && viewItem =~ /^path-/", "group": "1_actions@1" },
        { "command": "omCore.revealPath", "when": "view == omCore.launchPad && viewItem =~ /^path-(ok|not-om-core)$/", "group": "1_actions@2" },
        { "command": "omCore.openSettings", "when": "view == omCore.launchPad && viewItem =~ /^path-/", "group": "1_actions@3" },
        { "command": "omCore.uvInstallHelp", "when": "view == omCore.launchPad && viewItem =~ /^uv-(missing|elsewhere)$/", "group": "1_actions@1" }
      ],
      "commandPalette": [
        {
          "command": "omCore.openGui"
        },
        {
          "command": "omCore.closeGui"
        },
        {
          "command": "omCore.startRuntime"
        },
        {
          "command": "omCore.stopRuntime"
        },
        {
          "command": "omCore.reconnect"
        },
        {
          "command": "omCore.refreshStatus"
        },
        {
          "command": "omCore.choosePath"
        },
        {
          "command": "omCore.openSettings"
        },
        {
          "command": "omCore.revealPath"
        },
        {
          "command": "omCore.manageTrust",
          "when": "false"
        },
        {
          "command": "omCore.uvInstallHelp",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview && npm run build:bridge",
    "build:ext": "esbuild ./src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "build:webview": "esbuild ./webview/main.ts --bundle --platform=browser --format=iife --outfile=dist/webview.js && node -e \"require('fs').copyFileSync('webview/index.html','dist/index.html')\"",
    "build:bridge": "esbuild ./bridge/server.ts --bundle --platform=node --format=cjs --external:ws --outfile=dist/bridge.js",
    "watch:ext": "esbuild ./src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --watch",
    "watch:webview": "esbuild ./webview/main.ts --bundle --platform=browser --format=iife --outfile=dist/webview.js --watch",
    "compile": "tsc --noEmit",
    "test": "esbuild ./test-harness.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/test-harness.js && node dist/test-harness.js",
    "web": "npm run build && node dist/bridge.js",
    "package": "vsce package --no-dependencies",
    "check:sensitive": "node scripts/check-sensitive.js --all",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.4.0",
    "ws": "^8.16.0"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-sensitive.js --staged"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
