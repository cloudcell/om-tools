# Only dist/extension.js, dist/webview.{js,css}, dist/index.html, media/, README, LICENSE, NOTICE, legal/THIRD-PARTY-NOTICES.md
# and CHANGELOG go into the VSIX. Repository governance (CI, contributor and security documents) stays out; the licence
# notices of the bundled third-party material (e.g. Material Symbols, Apache-2.0) must ship with the extension.
.vscode/**
.devin/**
.idea/**
.gitattributes
.gitignore
AGENTS.md
*.sh
src/**
webview/**
bridge/**
shared/**
docs/**
scripts/**
node_modules/**
tsconfig.json
test-harness.ts
**/*.map
**/*.ts
**/*.vsix
dist/bridge.js
dist/test-harness.js
dist/_selftest.js
examples/**
.github/**
CONTRIBUTING.md
CONTRIBUTORS.md
SECURITY.md
legal/**
!legal/THIRD-PARTY-NOTICES.md
